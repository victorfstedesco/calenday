# Porta local do Node (o nginx faz proxy para ela)
PORT=3000

# Segredo de assinatura da sessão.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chaves do Web Push. Gere com: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com

# Horário do aviso para itens sem hora marcada
ALL_DAY_NOTIFY_TIME=08:00

# Intervalo, em minutos, do reenvio para lembretes marcados como "insistir até o check"
NAG_EVERY_MIN=30

# URL pública do app, usada no botão "Ver demandas" do resumo diário por email
# (os horários do resumo ficam em Configurações, dentro do app, por usuário)
APP_URL=https://seudominio.com

# Email (SMTP). Sem isso, só o push funciona.
# Gmail: use uma "senha de app", não a senha normal da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
